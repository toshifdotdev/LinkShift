# Frontend configuration.
#
# VITE_* variables are PUBLIC. They are inlined into the JavaScript bundle at
# build time and are readable by anyone who opens the site. Never put an API
# key, token, password or private key in this file.
#
# VITE_API_URL is the API BASE and MUST include the /api/v1 path segment.
# The client concatenates it with endpoint paths such as "/auth/login"
# (see src/api/client.ts -> buildUrl), so a value without /api/v1 would
# resolve to e.g. https://go.linkshift.in/auth/login and return 404.

# Production (baked into the bundle at build time by your CI / deploy step):
VITE_API_URL=https://go.linkshift.in/api/v1

# Local development, if you ever need the dev server to call the backend
# directly instead of through the Vite proxy:
# VITE_API_URL=http://localhost:3000/api/v1
#
# In practice this variable is NOT consulted while running `npm run dev`:
# src/api/client.ts uses the relative "/api/v1" when import.meta.env.DEV is
# true, and vite.config.ts proxies /api to http://localhost:3000. It is
# required for production builds.