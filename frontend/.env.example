# Frontend configuration.
#
# VITE_* variables are PUBLIC. They are inlined into the JavaScript bundle at
# build time and are readable by anyone who uses the site. Never put an API key,
# token, password or private key in this file.
#
# Base URL of the backend API, WITHOUT the /api/v1 suffix (the client appends
# /api/v1 itself, see src/api/client.ts).

# Production (baked into the bundle at build time by your CI / deploy step):
VITE_API_URL=https://go.linkshift.in/api/v1

# Local development, if you ever need the dev server to call the backend
# directly instead of through the Vite proxy:
# VITE_API_URL=http://localhost:3000/api/v1
#
# In practice this variable is NOT consulted while running `npm run dev`:
# src/api/client.ts uses the relative "/api/v1" when import.meta.env.DEV is
# true, and vite.config.ts proxies /api to http://localhost:3000. It is
# required for production builds.

# ---------------------------------------------------------------------------
# Marketing analytics (public website only)
# ---------------------------------------------------------------------------
# Cookieless, cookie-less analytics for linkshift.in. No cross-site
# identifiers, no advertising or cross-site tracking cookies on the marketing
# site.
#
# Leave this UNSET (or empty) to load nothing at all — that is the default, and
# what local and preview builds should use. Set it only for the production
# build, to the domain shown in your Plausible dashboard (e.g.
# linkshift.in). Nothing is requested when it is unset.
#
# This never affects the short-link redirect host (go.linkshift.in): the API
# runs a separate, stricter Content-Security-Policy and does not load this.
#
# VITE_PLAUSIBLE_DOMAIN=linkshift.in