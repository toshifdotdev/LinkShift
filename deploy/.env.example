# ============================================================================
# LinkShift EC2 host environment — copy to `.env` next to docker-compose.yml.
# This file is safe to commit; the real `.env` it describes is NOT (it holds
# production secrets) and is already excluded via .gitignore.
# ============================================================================

# Docker image to run — Docker Hub repository with a tag, e.g.
#   docker.io/<DOCKER_HUB_USERNAME>/linkshift-backend:v1
APP_IMAGE=

# ----------------------------------------------------------------------------
# Everything below is injected into the backend container at runtime
# (compose `env_file`). Copy the variable set from backend/.env.example and
# fill in PRODUCTION values. Never commit the real file.
#
# IMPORTANT: write values WITHOUT surrounding quotes. Docker compose strips
# quotes, but classic `docker run --env-file` does not — a quoted value like
# DATABASE_URL="postgresql://…" would break the connection string.
# ----------------------------------------------------------------------------
