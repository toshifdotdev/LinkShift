generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PatternStyle {
  square
  dots
  rounded
}

enum EyeStyle {
  square
  dot
  extraRounded
}

enum EyeBallStyle {
  square
  dot
}

enum AuthProvider {
    LOCAL
    GOOGLE
}

enum SubscriptionStatus {
    ACTIVE
    PENDING
    HALTED
    PAUSED
    CANCELLED
    COMPLETED
    EXPIRED
}

enum PaymentProvider {
  NONE
  STRIPE
  RAZORPAY
}

enum PlanName {
  FREE
  STARTER
  CREATOR
  PRO
  ENTERPRISE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum Currency {
    INR
    USD
}

model User {
  id                     String      @id @default(cuid())
  name                   String?   
  email                  String      @unique
  verified               Boolean     @default(false)

  passwordHash           String?
  resetPasswordToken     String?
  resetPasswordExpires   DateTime?

  googleId               String?     @unique
  avatarUrl              String?
  avatarPublicId         String?
  provider               AuthProvider

  refreshTokenHash       String? 
  refreshTokenExpiresAt  DateTime?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  links      Link[]

  domains    Domain[]

  emailVerification     EmailVerification?

  subscriptions  Subscription[]
  payments       Payment[]
  linkChanges    LinkChange[]
}

model EmailVerification {
  id            String   @id @default(cuid())

  tokenHash     String   @unique

  expiresAt     DateTime

  userId        String @unique
  user   User   @relation(fields:[userId], references:[id], onDelete:Cascade)

  createdAt DateTime @default(now())
}

model Domain {
  id         String   @id @default(cuid())

  host       String   @unique
  verified   Boolean  @default(false)
  verifiedAt DateTime?
  isDefault  Boolean  @default(false)

  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  links      Link[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Link {
  id         String   @id @default(cuid())
  userId     String
  name       String?
  passwordHash String?
  targetUrl  String
  shortId    String   
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  expiresAt  DateTime?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  user   User   @relation(fields: [userId], references: [id])
  qr     Qr[]
  scans  Scan[]
  linkChanges    LinkChange[]

  domainId String

  domain Domain @relation(fields: [domainId], references: [id])

  @@index([userId])

  @@unique([domainId, shortId])
}

model Qr {
  id               String   @id @default(cuid())

  linkId           String

  imageUrl         String
  imagePublicId    String

  foregroundColor  String?  @default("#000000")
  backgroundColor  String?  @default("#FFFFFF")

  logoUrl          String?
  logoPublicId     String?
  

  pattern          PatternStyle  @default(square)
  eyeStyle         EyeStyle      @default(square)
  eyeBallStyle     EyeBallStyle  @default(square)

  margin           Int?     @default(2)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
}

model Scan {
  id         String   @id @default(cuid())
  linkId     String
  device     String?
  browser    String?
  os         String?
  country    String?
  city       String?
  ipAddress  String?
 
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  scannedAt  DateTime @default(now())

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@index([linkId, scannedAt])
}


model Plan {
  id            String   @id @default(cuid())

  name          PlanName @unique

  monthlyPrice  Int
  yearlyPrice   Int?

  razorpayMonthlyPlanId String?
  razorpayYearlyPlanId  String?

  usdMonthlyPrice Int?
  usdYearlyPrice  Int?

  razorpayUsdMonthlyPlanId String?
  razorpayUsdYearlyPlanId  String?
  
  maxLinks      Int?
  maxQrPerMonth Int?
  maxDomains    Int?
  maxRedirectsPerMonth Int?
  maxRedirectsWithGracePerMonth Int?

  maxCustomSlugsPerMonth Int?

  maxDestinationChangesPerMonth Int?

  analyticsDays Int

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  payments      Payment[]

  subscriptions Subscription[]
  pendingSubscriptions Subscription[] @relation("PendingSubscriptionPlan")
}


model Subscription {
  id     String @id @default(cuid())

  userId String 
  user   User   @relation(fields: [userId],references: [id],onDelete: Cascade)

  planId String 
  plan   Plan   @relation(fields: [planId],references: [id])

  currency Currency @default(INR)

  status SubscriptionStatus @default(ACTIVE)

  provider PaymentProvider  @default(NONE)

  billingCycle BillingCycle

  providerSubscriptionId String?
  providerCustomerId String?

  pendingPlanId String?
  pendingPlan   Plan? @relation("PendingSubscriptionPlan", fields: [pendingPlanId], references: [id])

  changeScheduledAt DateTime?

  startedAt DateTime @default(now())

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  cancelAtPeriodEnd Boolean   @default(false)
  cancelledAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@unique([provider, providerSubscriptionId])
  @@index([userId])
}


model Payment {
  id String @id @default(cuid())
  
  planId String
  plan   Plan  @relation(fields: [planId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId],references: [id],onDelete: SetNull)

  provider PaymentProvider

  providerOrderId     String
  providerPaymentId   String?
  providerSignature   String?
  billingCycle        BillingCycle

  amount   Int
  currency Currency @default(INR)

  status PaymentStatus

  createdAt DateTime @default(now())

  @@unique([provider, providerOrderId])
  @@unique([provider, providerPaymentId])
  @@index([userId])
  @@index([subscriptionId])
}


enum LinkChangeType {
    DESTINATION
    CUSTOM_SLUG
}

model LinkChange {
    id        String         @id @default(cuid())

    userId    String
    linkId    String

    type      LinkChangeType

    createdAt DateTime       @default(now())

    user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
    link       Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

    @@index([userId, type, createdAt])
    @@index([linkId])
}

