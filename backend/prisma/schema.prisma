generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PatternStyle {
  square
  dots
  rounded
}

enum EyeStyle {
  square
  dot
  extraRounded
}

enum EyeBallStyle {
  square
  dot
}

enum AuthProvider {
    LOCAL
    GOOGLE
}

enum SubscriptionStatus {
    ACTIVE

    // DEPRECATED - transitional only.
    // Replaced by AUTHORIZATION_PENDING / PAYMENT_RETRY (Wave 0).
    // Kept so legacy code compiles until billing waves 1-3 stop writing it.
    // Postgres cannot drop enum labels; do NOT write this value from new code.
    PENDING

    AUTHORIZATION_PENDING
    PAYMENT_RETRY

    HALTED
    PAUSED
    CANCELLED
    COMPLETED
    EXPIRED
}

enum PaymentProvider {
  NONE
  STRIPE
  RAZORPAY
}

enum PlanName {
  FREE
  STARTER
  CREATOR
  PRO
  ENTERPRISE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// NULL on legacy rows ≡ SUBSCRIPTION (zero-backfill convention).
// PRORATION rows are provisional: subscription.charged / payment.captured
// adoption paths flip them to SUBSCRIPTION when a cycle charge claims them.
enum PaymentCategory {
  SUBSCRIPTION
  PRORATION
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum Currency {
    INR
    USD
}

enum WebhookEventStatus {
    PENDING
    PROCESSING
    PROCESSED
    FAILED
}

model WebhookEvent {
    id          String   @id @default(cuid())
    eventId     String   @unique
    eventType   String
    status      WebhookEventStatus @default(PENDING)
    claimedAt   DateTime?
    processedAt DateTime?
    createdAt   DateTime @default(now())

    @@index([status])
}

model User {
  id                     String      @id @default(cuid())
  name                   String?   
  email                  String      @unique
  verified               Boolean     @default(false)

  passwordHash           String?
  resetPasswordToken     String?
  resetPasswordExpires   DateTime?

  googleId               String?     @unique
  avatarUrl              String?
  avatarPublicId         String?
  provider               AuthProvider

  refreshTokenHash       String? 
  refreshTokenExpiresAt  DateTime?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  links      Link[]

  domains    Domain[]

  emailVerification     EmailVerification?

  subscriptions  Subscription[]
  payments       Payment[]
  linkChanges    LinkChange[]
}

model EmailVerification {
  id            String   @id @default(cuid())

  tokenHash     String   @unique

  expiresAt     DateTime

  userId        String @unique
  user   User   @relation(fields:[userId], references:[id], onDelete:Cascade)

  createdAt DateTime @default(now())
}

model Domain {
  id         String   @id @default(cuid())

  host       String   @unique
  verified   Boolean  @default(false)
  verifiedAt DateTime?
  isDefault  Boolean  @default(false)

  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  links      Link[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Link {
  id         String   @id @default(cuid())
  userId     String
  name       String?
  passwordHash String?
  targetUrl  String
  shortId    String   
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  expiresAt  DateTime?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  user   User   @relation(fields: [userId], references: [id])
  qr     Qr[]
  scans  Scan[]
  linkChanges    LinkChange[]

  domainId String

  domain Domain @relation(fields: [domainId], references: [id])

  @@index([userId])

  @@unique([domainId, shortId])
}

model Qr {
  id               String   @id @default(cuid())

  linkId           String

  imageUrl         String
  imagePublicId    String

  foregroundColor  String?  @default("#000000")
  backgroundColor  String?  @default("#FFFFFF")

  logoUrl          String?
  logoPublicId     String?
  

  pattern          PatternStyle  @default(square)
  eyeStyle         EyeStyle      @default(square)
  eyeBallStyle     EyeBallStyle  @default(square)

  margin           Int?     @default(2)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
}

model Scan {
  id         String   @id @default(cuid())
  linkId     String
  device     String?
  browser    String?
  os         String?
  country    String?
  city       String?
  ipAddress  String?  // stored per SCAN_IP_PRIVACY (default: /24-/48 truncated)
  referrer   String?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  scannedAt  DateTime @default(now())

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@index([linkId, scannedAt])
}


model Plan {
  id            String   @id @default(cuid())

  name          PlanName @unique

  monthlyPrice  Int
  yearlyPrice   Int?

  razorpayMonthlyPlanId String?
  razorpayYearlyPlanId  String?

  usdMonthlyPrice Int?
  usdYearlyPrice  Int?

  razorpayUsdMonthlyPlanId String?
  razorpayUsdYearlyPlanId  String?
  
  maxLinks      Int?
  maxQrPerMonth Int?
  maxDomains    Int?
  maxRedirectsPerMonth Int?
  maxRedirectsWithGracePerMonth Int?

  maxCustomSlugsPerMonth Int?

  maxDestinationChangesPerMonth Int?

  analyticsDays Int

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  payments      Payment[]

  subscriptions Subscription[]
  pendingSubscriptions Subscription[] @relation("PendingSubscriptionPlan")
}


model Subscription {
  id     String @id @default(cuid())

  userId String 
  user   User   @relation(fields: [userId],references: [id],onDelete: Cascade)

  planId String 
  plan   Plan   @relation(fields: [planId],references: [id])

  currency Currency @default(INR)

  status SubscriptionStatus @default(ACTIVE)

  provider PaymentProvider  @default(NONE)

  billingCycle BillingCycle

  providerSubscriptionId String?
  providerCustomerId String?

  pendingPlanId String?
  pendingPlan   Plan? @relation("PendingSubscriptionPlan", fields: [pendingPlanId], references: [id])

  changeScheduledAt DateTime?

  startedAt DateTime @default(now()) @db.Timestamptz(3)

  currentPeriodStart DateTime? @db.Timestamptz(3)
  currentPeriodEnd   DateTime? @db.Timestamptz(3)

  cancelAtPeriodEnd Boolean   @default(false)
  cancelledAt       DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@unique([provider, providerSubscriptionId])
  @@index([userId])
}


model Payment {
  id String @id @default(cuid())
  
  planId String
  plan   Plan  @relation(fields: [planId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId],references: [id],onDelete: SetNull)

  provider PaymentProvider

  providerOrderId     String
  providerPaymentId   String?
  providerSignature   String?
  providerRefundId    String?
  billingCycle        BillingCycle

  amount   Int
  currency Currency @default(INR)

  status PaymentStatus
  category PaymentCategory?

  refunds Refund[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([provider, providerOrderId])
  @@unique([provider, providerPaymentId])
  @@index([userId])
  @@index([subscriptionId])
}

// Cumulative refund ledger for a Payment. providerRefundId is the idempotency
// anchor: duplicate deliveries and stale-claim re-entry can never double-count.
// Payment.status flips to REFUNDED when SUM(refunds.amount) >= payment.amount.
model Refund {
  id               String          @id @default(cuid())
  paymentId        String
  payment          Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  provider         PaymentProvider @default(RAZORPAY)
  providerRefundId String          @unique
  amount           Int
  currency         Currency
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)

  @@index([paymentId])
}

// Wave 4 reconciliation: one row per pass. The partial unique index on the
// constant (1) WHERE status='running' is a STRUCTURAL single-runner lock across
// all machines; stale 'running' rows older than the lease TTL are reclaimed by
// the next trigger (crash recovery). Doubles as run audit/stats.
model ReconciliationRun {
  id          String    @id @default(cuid())
  status      String    // 'running' | 'completed' | 'failed'
  triggeredBy String    @default("external")
  stats       Json?
  startedAt   DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt  DateTime? @db.Timestamptz(3)
}


enum LinkChangeType {
    DESTINATION
    CUSTOM_SLUG
}

model LinkChange {
    id        String         @id @default(cuid())

    userId    String
    linkId    String

    type      LinkChangeType

    createdAt DateTime       @default(now())

    user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
    link       Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

    @@index([userId, type, createdAt])
    @@index([linkId])
}

