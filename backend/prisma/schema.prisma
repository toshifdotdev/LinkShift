generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PatternStyle {
  square
  dots
  rounded
}

enum EyeStyle {
  square
  dot
  extraRounded
}

enum EyeBallStyle {
  square
  dot
}

enum AuthProvider {
    LOCAL
    GOOGLE
}

model User {
  id                     String      @id @default(cuid())
  name                   String?   
  email                  String      @unique
  passwordHash           String?
  resetPasswordToken     String?
  resetPasswordExpires   DateTime?

  googleId               String?     @unique
  avatarUrl              String?
  provider               AuthProvider

  refreshTokenHash String? 
  refreshTokenExpiresAt DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  links      Link[]

  domains    Domain[]
}

model Domain {
  id         String   @id @default(cuid())

  host       String   @unique
  verified   Boolean  @default(false)
  verifiedAt DateTime?
  isDefault  Boolean  @default(false)

  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  links      Link[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Link {
  id         String   @id @default(cuid())
  userId     String
  name       String?
  passwordHash String?
  targetUrl  String
  shortId    String   
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  expiresAt  DateTime?

  user   User   @relation(fields: [userId], references: [id])
  qr     Qr[]
  scans  Scan[]

  domainId String

  domain Domain @relation(fields: [domainId], references: [id])

  @@index([userId])

  @@unique([domainId, shortId])
}

model Qr {
  id               String   @id @default(cuid())

  linkId           String

  imageUrl         String

  foregroundColor  String?  @default("#000000")
  backgroundColor  String?  @default("#FFFFFF")

  logoUrl          String?

  pattern          PatternStyle  @default(square)
  eyeStyle         EyeStyle      @default(square)
  eyeBallStyle     EyeBallStyle  @default(square)

  margin           Int?     @default(2)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
}

model Scan {
  id         String   @id @default(cuid())
  linkId     String
  device     String?
  browser    String?
  os         String?
  country    String?
  city       String?
  ipAddress  String?
  scannedAt  DateTime @default(now())

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
}

