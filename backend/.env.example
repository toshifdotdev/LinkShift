
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
DIRECT_URL="postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

DATABASE_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000

JWT_SECRET=change-me-to-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Origin of the frontend that is allowed to call this API.
#   development -> http://localhost:5173   (the local Vite dev server)
#   production  -> https://linkshift.in
FRONTEND_URL=http://localhost:5173

# Comma-separated CORS allow-list. Leave EMPTY (or unset) to fall back to
# FRONTEND_URL above. An empty value is treated as "not set", not as
# "no origins allowed". Set it only when more than one origin needs API
# access, e.g.
#   CORS_ORIGINS=https://linkshift.in,https://staging.example.com
# Wildcard "*" is rejected when NODE_ENV=production, and an empty list in
# production fails at boot rather than silently rejecting every origin.
CORS_ORIGINS=

RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


RECON_SECRET=


SCAN_IP_PRIVACY=truncated

# One Caddy proxy hop sits in front of the app in production. Never set this
# to `true`: a value higher than the real hop count lets clients forge
# X-Forwarded-For and defeat rate limiting.
TRUST_PROXY_HOPS=0

# Hosts the server is allowed to fetch a QR logo from. A logo URL is only
# ever produced by the upload endpoint, which returns a Cloudinary
# secure_url, so the studio has no field for pasting an arbitrary address.
# Add comma-separated hosts here if that ever changes.
QR_LOGO_ALLOWED_HOSTS=res.cloudinary.com
