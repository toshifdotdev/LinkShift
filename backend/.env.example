# ============================================================================
# LinkShift backend — environment template
# Copy to .env (dev) or your platform's secret store (production) and fill in.
# NEVER commit real values. See ENVIRONMENT.md for the full matrix.
# ============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# --- Database (Neon) ---------------------------------------------------------
# DATABASE_URL   : POOLED endpoint (-pooler host) — used by the app runtime.
# DIRECT_URL     : DIRECT (non-pooler) endpoint — used by Prisma CLI/migrations.
# Get both from the Neon console ("pooled connection" / "direct connection").
DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
DIRECT_URL="postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Runtime pg.Pool tuning (src/config/prisma.ts)
DATABASE_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000

# --- Auth / JWT ---------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Full BACKEND url Google redirects to after OAuth:
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# Origin of the frontend SPA (email reset links + post-verification redirect):
FRONTEND_URL=http://localhost:5173
# Allowed CORS origins for the API. Optional — defaults to FRONTEND_URL above.
# Set this (comma-separated) only when more than one origin needs API access,
# e.g. staging + production: CORS_ORIGINS=https://app.example.com,https://staging.example.com
CORS_ORIGINS=

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=

# --- Cloudinary (avatars + QR images) -----------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay -----------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
# Webhook secret configured in the Razorpay dashboard:
RAZORPAY_WEBHOOK_SECRET=

# --- Reconciliation (internal endpoint auth) ----------------------------------
# 64-hex random value; send as  x-recon-secret  header to
# POST /api/v1/internal/reconciliation/run
RECON_SECRET=

# --- Privacy / proxy behavior -------------------------------------------------
# Scan IP storage: truncated (default, /24 v4 + /48-ish v6) | full
SCAN_IP_PRIVACY=truncated
# Number of trusted reverse-proxy hops in front of the API (0 = none/local).
# Production behind one LB/nginx: 1. Behind Cloudflare + nginx: 2. Never `true`.
TRUST_PROXY_HOPS=0

# Verified Resend sender identity. Production MUST use a domain you own —
# onboarding@resend.dev only delivers to your own account email.
EMAIL_FROM=
